# REXAM BACKEND ENVIRONMENT CONFIGURATION
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# SUPABASE CREDENTIALS (PostgreSQL & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# AUTHENTICATION & SECURITY
SECRET_KEY=generate-a-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & AI EXTRACTION CONFIGURATION
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
GEMINI_API_KEY=

# LOGGING
LOG_LEVEL=INFO
