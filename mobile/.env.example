# REXAM MOBILE APPLICATION CONFIGURATION (.env)
# Provide your Supabase project credentials (safe client-side publishable key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# OAUTH REDIRECT URL
SUPABASE_REDIRECT_URL=io.supabase.rexam://login-callback

