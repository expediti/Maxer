# Supabase Configuration (Used exclusively by Python Data Engine / GitHub Actions)
# NEVER expose the service role key to the Flutter mobile app!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cloudflare Workers AI Configuration (Optional extraction provider)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-api-token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Engine Crawler Configuration
CRAWLER_USER_AGENT=RexamOpportunityBot/1.0 (+https://rexam.in; compliance@rexam.in)
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_DELAY_SECONDS=2.0
STORAGE_DIR=/tmp/rexam_downloads
ENVIRONMENT=development

